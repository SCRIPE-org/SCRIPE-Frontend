{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@core/*": ["./src/core/*"],
      "@modules/analytics": ["./src/modules/analytics/analytics"],
      "@modules/analytics/*": ["./src/modules/analytics/analytics/*"],
      "@modules/auth": ["./src/modules/shared/auth"],
      "@modules/auth/*": ["./src/modules/shared/auth/*"],
      "@modules/communication": ["./src/modules/admin/communication"],
      "@modules/communication/*": ["./src/modules/admin/communication/*"],
      "@modules/compliance": ["./src/modules/admin/compliance"],
      "@modules/compliance/*": ["./src/modules/admin/compliance/*"],
      "@modules/custom-fields": ["./src/modules/custom-fields/custom-fields"],
      "@modules/custom-fields/*": ["./src/modules/custom-fields/custom-fields/*"],
      "@modules/customization": ["./src/modules/admin/customization"],
      "@modules/customization/*": ["./src/modules/admin/customization/*"],
      "@modules/docs": ["./src/modules/shared/docs"],
      "@modules/docs/*": ["./src/modules/shared/docs/*"],
      "@modules/ecosystem": ["./src/modules/admin/ecosystem"],
      "@modules/ecosystem/*": ["./src/modules/admin/ecosystem/*"],
      "@modules/entitlements": ["./src/modules/billing/entitlements"],
      "@modules/entitlements/*": ["./src/modules/billing/entitlements/*"],
      "@modules/home": ["./src/modules/shared/home"],
      "@modules/home/*": ["./src/modules/shared/home/*"],
      "@modules/hrms": ["./src/modules/hrms/hrms"],
      "@modules/hrms/*": ["./src/modules/hrms/hrms/*"],
      "@modules/identity": ["./src/modules/admin/identity"],
      "@modules/identity/*": ["./src/modules/admin/identity/*"],
      "@modules/integrations": ["./src/modules/admin/integrations"],
      "@modules/integrations/*": ["./src/modules/admin/integrations/*"],
      "@modules/marketplace": ["./src/modules/marketplace/marketplace"],
      "@modules/marketplace/*": ["./src/modules/marketplace/marketplace/*"],
      "@modules/media": ["./src/modules/media/media"],
      "@modules/media/*": ["./src/modules/media/media/*"],
      "@modules/monitoring": ["./src/modules/analytics/monitoring"],
      "@modules/monitoring/*": ["./src/modules/analytics/monitoring/*"],
      "@modules/party-kernel": ["./src/modules/party-kernel/party-kernel"],
      "@modules/party-kernel/*": ["./src/modules/party-kernel/party-kernel/*"],
      "@modules/plugins": ["./src/modules/plugins/plugins"],
      "@modules/plugins/*": ["./src/modules/plugins/plugins/*"],
      "@modules/profile": ["./src/modules/shared/profile"],
      "@modules/profile/*": ["./src/modules/shared/profile/*"],
      "@modules/work-management": ["./src/modules/work-management/work-management"],
      "@modules/work-management/*": ["./src/modules/work-management/work-management/*"],
      "@modules/*": ["./src/modules/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "vitest.config.ts",
    "vitest.setup.ts",
    "**/__tests__/**",
    "**/*.stories.tsx",
    "**/*.stories.ts",
    ".storybook"
  ]
}
