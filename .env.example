# ============================================
# NEXORA Frontend Environment Variables
# ============================================

# Base API URL (monolith mode - all modules use this)
NEXT_PUBLIC_API_URL=https://localhost:5001/api

# ── Module-Specific API URLs (microservice mode) ──
# Leave empty to use NEXT_PUBLIC_API_URL as fallback

# Entitlements Module (leave empty to use NEXT_PUBLIC_API_URL as fallback)
NEXT_PUBLIC_ENTITLEMENTS_API_URL=http://localhost:5004/api


# Compliance Module (leave empty to use NEXT_PUBLIC_API_URL as fallback)
NEXT_PUBLIC_COMPLIANCE_API_URL=http://localhost:5005/api

# Plugins Module (leave empty to use NEXT_PUBLIC_API_URL as fallback)
NEXT_PUBLIC_PLUGINS_API_URL=http://localhost:5006/api

# Marketplace Module (leave empty to use NEXT_PUBLIC_API_URL as fallback)
NEXT_PUBLIC_MARKETPLACE_API_URL=http://localhost:5007/api
